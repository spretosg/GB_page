---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<Layout title="Berggitzi - für Alle">

<p>
  <span class="badge">2.75 km</span>
  <span class="badge">+130 Hm</span>
  <span class="badge">Kinder, Jugendliche, Geniesser</span>
</p>

<hr />

<h2>Start</h2>
<p><strong>18:30 – Braunwald Rehaklinik</strong></p>

<h2>Highlights</h2>
<ul>
  <li>Sonnenterrasse Braunwald</li>
  <li>Leichte Anstiege</li>
  <li>Kieswege</li>
  <li>Aussicht</li>
  <li>Ziel: Hüttenberg</li>
</ul>

<h2>Transport & Gepäck</h2>
 <ul>
    <li>Startnummern müssen bei der Talstation Linthal Braunwaldbahn abgeholt werden/li>
    <li>Bergfahrt nach Braunwald (spätestens 17.55, Ticket im Startgeld inbegriffen)</li>
    <li>Gepäckabgabe bei der Rehaklinik bis 18.25</li>
    <li>❌ Keine Toiletten am Start</li>
  </ul>



<h2>Karte</h2>
<iframe src="https://map.geo.admin.ch/#/embed?lang=en&center=2717587.51,1199715.59&z=9.228&topic=ech&layers=ch.swisstopo.zeitreihen@year=1864,f;ch.bfs.gebaeude_wohnungs_register,f;ch.bav.haltestellen-oev,f;ch.swisstopo.swisstlm3d-wanderwege,f;ch.vbs.schiessanzeigen,f;ch.astra.wanderland-sperrungen_umleitungen,f;KML%7Chttps://public.geo.admin.ch/api/kml/files/1cf5tRuGQu2mj0R5cDaixA&bgLayer=ch.swisstopo.pixelkarte-farbe&featureInfo=default" 
height="400"
style="width:100%; border-radius:12px;"
allow="geolocation"></iframe>

<h3>Höhenprofil</h3>

<div class="image-wrapper">
  <img 
    src={`/img/berggitzi_profil.png`} 
    alt="Höhenprofil Belvedere" 
    class="clickable"
    onclick="openModal(this.src)"
  />
</div>

<!-- MODAL -->
<div id="modal" class="modal" onclick="closeModal()">
  <img id="modal-img" />
</div>

<script>
  function openModal(src) {
    const modal = document.getElementById("modal");
    const img = document.getElementById("modal-img");
    img.src = src;
    modal.style.display = "flex";
  }

  function closeModal() {
    document.getElementById("modal").style.display = "none";
  }
</script>

</Layout>
