---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Startliste, Ranglisten & Bilder">

  <p>
    Hier findest du die aktuelle Startliste, Ranglisten, Bilder und Medienberichte vergangener Austragungen.
  </p>

  <h3>Ranglisten</h3>

  <ul class="results">
    <li><a href="https://my.raceresult.com/146939/">1. Glarner Berggeiss 2020</a></li>
    <li><a href="https://my.raceresult.com/162085/">2. Glarner Berggeiss 2021</a></li>
    <li><a href="https://my.raceresult.com/191313/">3. Glarner Berggeiss 2022</a></li>
    <li><a href="https://my.raceresult.com/216668/">4. Glarner Berggeiss 2023</a></li>
    <li><a href="https://my.raceresult.com/259731/">5. Glarner Berggeiss 2024</a></li>
    <li><a href="https://my.raceresult.com/352958/">6. Glarner Berggeiss 2025</a></li>
    <li><a href="https://my.raceresult.com/385820/">7. Glarner Berggeiss 2026</a></li>
  </ul>

  <h3>Bilder</h3>

  <div class="image-grid">
    <button class="image-preview" data-image="/img/res/sieger1.jpg">
      <img src="/img/res/sieger1.jpg" alt="Glarner Berggeiss" />
    </button>

    <button class="image-preview" data-image="/img/res/sieger2.jpg">
      <img src="/img/res/sieger2.jpg" alt="Glarner Berggeiss" />
    </button>

    <button class="image-preview" data-image="/img/res/sieger3.jpg">
      <img src="/img/res/sieger3.jpg" alt="Glarner Berggeiss" />
    </button>

    <button class="image-preview" data-image="/img/res/sieger4.jpg">
      <img src="/img/res/sieger4.jpg" alt="Glarner Berggeiss" />
    </button>

        <button class="image-preview" data-image="/img/res/lauf1.jpg">
      <img src="/img/res/lauf1.jpg" alt="Glarner Berggeiss" />
    </button>

        <button class="image-preview" data-image="/img/res/lauf2.jpg">
      <img src="/img/res/lauf2.jpg" alt="Glarner Berggeiss" />
    </button>

        <button class="image-preview" data-image="/img/res/lauf3.jpg">
      <img src="/img/res/lauf3.jpg" alt="Glarner Berggeiss" />
    </button>

        <button class="image-preview" data-image="/img/res/lauf4.jpg">
      <img src="/img/res/lauf4.jpg" alt="Glarner Berggeiss" />
    </button>
  </div>

  <dialog id="image-modal">
    <button class="modal-close" aria-label="Bild schliessen">×</button>
    <img id="modal-image" src="" alt="Glarner Berggeiss" />
  </dialog>

  <h3>Medien</h3>

  <style>
    .results {
      list-style: none;
      padding: 0;
    }

    .results li {
      margin: 0.4rem 0;
    }

    .results a {
      display: inline-block;
    }

    .newsletter {
      margin-top: 1.5rem;
      display: flex;
      justify-content: center;
    }

    iframe {
      width: 100%;
      max-width: 540px;
      height: 305px;
      border: none;
      border-radius: 12px;
    }

    a {
      color: #2563eb;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    /* Image grid */
    .image-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin: 1rem 0 2rem;
    }

    .image-preview {
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
      overflow: hidden;
      border-radius: 12px;
    }

    .image-preview img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      transition: transform 0.2s ease;
    }

    .image-preview:hover img {
      transform: scale(1.04);
    }

    /* Lightbox */
    #image-modal {
      position: relative;
      border: none;
      padding: 0;
      background: transparent;
      max-width: 90vw;
      max-height: 90vh;
    }

    #image-modal::backdrop {
      background: rgba(0, 0, 0, 0.8);
    }

    #image-modal img {
      display: block;
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 8px;
    }

    .modal-close {
      position: absolute;
      top: -40px;
      right: 0;
      border: none;
      background: none;
      color: white;
      font-size: 2rem;
      cursor: pointer;
    }

    @media (max-width: 800px) {
      .image-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 500px) {
      .image-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const modal = document.querySelector("#image-modal");
    const modalImage = document.querySelector("#modal-image");
    const closeButton = document.querySelector(".modal-close");

    document.querySelectorAll(".image-preview").forEach((button) => {
      button.addEventListener("click", () => {
        const image = button.getAttribute("data-image");

        if (image && modal && modalImage) {
          modalImage.src = image;
          modal.showModal();
        }
      });
    });

    closeButton?.addEventListener("click", () => {
      modal?.close();
    });

    modal?.addEventListener("click", (event) => {
      if (event.target === modal) {
        modal.close();
      }
    });
  </script>

</Layout>