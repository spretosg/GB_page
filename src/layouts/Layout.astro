---
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body>
<style>

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
}

.menu {
  display: none;
  flex-direction: column;
  gap: 1rem;
}

.menu.open {
  display: flex;
}

.hamburger {
  font-size: 1.5rem;
  cursor: pointer;
  background: none;
  border: none;
  color: white;
  position: relative;
  z-index: 20;
}

@media (min-width: 768px) {
  .menu {
    display: flex !important;
    flex-direction: row;
  }

  .hamburger {
    display: none;
  }
}

body {
  margin: 0;
  font-family: system-ui, sans-serif;
  background: #f7f7f7;
  color: #1a1a1a;
}

/* HEADER */
.header {
  position: absolute;
  top: 10px;
  left: 0;
  width: 90%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  z-index: 10;
}

.nav-btn {
  color: white;
  text-decoration: none;
  font-weight: 600;
  padding: 0.5rem 1rem;
  border-radius: 999px;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(6px);
  transition: all 0.2s ease;
}

.nav-btn:hover {
  background: rgba(0,0,0,0.6);
}

      /* HERO */
.hero {
  background-image: url('/img/hero_img.jpg');
  width: 100%;
  height: 200px;
  background-position: top;
  background-repeat: no-repeat;
  background-size: cover !important;   /* 👈 force it */


  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;
  padding: 2rem 1rem;
}

.hero h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  background: rgba(0,0,0,0.5);
  color: white;
  padding: 1.2rem 2.5rem;
  border-radius: 12px;

  margin: 0;                 /* reset default */
}



/* CONTENT */
.content {
  max-width: 90%;
  margin: -10px auto 2rem;
  padding: 2rem;
  background: white;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

@media (max-width: 600px) {
  .header {
    padding: 1rem;
  }

  .content {
    margin: -40px 1rem 2rem;
    padding: 1.5rem;
  }
}

      /* FOOTER */
.footer {
  background: #ffffff;
  color: white;
  padding: 3rem 1rem;
  margin-top: 3rem;
  text-align: center;
}

.sponsor-section {
  margin-bottom: 2rem;
}

.sponsor-section h3 {
  margin-bottom: 1rem;
}

/* GRID */
.sponsors {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 3rem;
}

/* LOGOS */
.sponsors img {
  object-fit: contain;
}

.sponsors img:hover {
  opacity: 1;
  transform: scale(1.05);
}

/* SIZE HIERARCHY */
.sponsors.main img {
  height: 150px;
}

.sponsors.gold img {
  height: 130px;
}

.sponsors.silver img {
  height: 50px;
}

.sponsors.supporter img {
  height: 20px;
}
</style>




    <!-- HEADER -->
    <div class="header">
      

    <nav class="nav">
     
      <button class="hamburger" id="menu-btn">☰</button>

      <div class="menu" id="menu">
        <a href={`${base}`}>Home</a>
        <a href="der_lauf">Strecken</a>
        <a href="about">Ueber uns</a>
        <a href="results">Resultate</a>
      </div>
    </nav>
    </div>

    <!-- HERO -->
    <div class="hero">
      <h1>{title}</h1>
    </div>

    <!-- CONTENT -->
    <div class="content">
      <slot />
    </div>



    <!-- FOOTER -->
<footer class="footer">

  <div class="sponsor-section">
    <h2 style="color:#000000;">Hauptsponsoren</h2>
    <div class="sponsors main">
      
      <a href="https://www.grb.ch/" target="_blank" rel="noopener noreferrer">
        <img src="/img/sponsors/grb1.png" alt="GRB" />
      </a>
      <a href="https://www.3614.ch/" target="_blank" rel="noopener noreferrer">
    <img src="/img/sponsors/toedi1.png" alt="Toedi Sport" />
      </a>
    </div>
    <br></br>
    <h2 style="color:#000000;">Gold</h2>
    <div class="sponsors gold">
      <a href="https://www.baebler-heizungen.ch/" target="_blank" rel="noopener noreferrer">
      <img src="/img/sponsors/baebler1.png" alt="Baebler" />
      </a>
    </div>
    <br></br>
    <h2 style="color:#000000;">Silber</h2>
    <div class="sponsors silver">
      <a href="https://www.kspartner.ch/" target="_blank" rel="noopener noreferrer">
      <img src="/img/sponsors/ks1.png" alt="KS partner" />
      </a>
      <a href="https://www.service7000.ch/" target="_blank" rel="noopener noreferrer">
        <img src="/img/sponsors/service1.PNG" alt="Service7000" />
      </a>
      <a href="https://hoesli.swiss/" target="_blank" rel="noopener noreferrer">
        <img src="/img/sponsors/hoesli1.png" alt="Hösli" />
      </a>
    </div>
    <br></br>
    <h2 style="color:#000000;">Unterstützer</h2>
    <div class="sponsors silver">
      <img src={`/img/sponsors/isostar.svg`} />
      <img src={`/img/sponsors/marel1.png`} />
    </div>
  </div>

</footer>

  </body>
</html>


<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu');

  btn.addEventListener('click', () => {
    menu.classList.toggle('open');
  });
</script>
